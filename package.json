{
  "name": "sensemaking",
  "version": "0.17.1",
  "description": "Query and search your markdown notes with context-aware progressive disclosure: SQL over frontmatter, links, and text, plus semantic search and link-graph ranking. No server, no build step",
  "keywords": [
    "markdown",
    "frontmatter",
    "sql",
    "sqlite",
    "fts5",
    "full-text-search",
    "query",
    "search",
    "multilingual",
    "cjk",
    "semantic-search",
    "hybrid-search",
    "knowledge-base",
    "rag",
    "progressive-disclosure",
    "graph-traversal",
    "link-graph",
    "wikilinks",
    "backlinks",
    "markdown-database",
    "document-os",
    "notes",
    "obsidian",
    "obsidian-bases",
    "markdowndb",
    "mdbase",
    "iwe",
    "silverbullet",
    "logseq",
    "anytype",
    "zk",
    "agent",
    "agent-memory",
    "memory-consolidation",
    "llm-wiki",
    "second-brain",
    "company-brain",
    "dreaming",
    "cli"
  ],
  "homepage": "https://github.com/kmalakoff/sensemaking",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/kmalakoff/sensemaking.git"
  },
  "license": "MIT",
  "author": "Kevin Malakoff <kmalakoff@gmail.com> (https://github.com/kmalakoff)",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/cjs/index.js",
  "source": "src/index.ts",
  "types": "dist/cjs/index.d.ts",
  "bin": {
    "sense": "bin/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "schema.json"
  ],
  "scripts": {
    "build": "tsds build",
    "format": "tsds format",
    "prepublishOnly": "tsds validate",
    "test": "tsds test:node --no-timeouts",
    "test:engines": "nvu engines tsds test:node --no-timeouts",
    "version": "tsds version"
  },
  "dependencies": {
    "@huggingface/tokenizers": "^0.1.3",
    "franc-min": "^6.2.0",
    "install-module-linked": "^1.6.5",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm-autolink-literal": "^2.0.0",
    "mdast-util-gfm-footnote": "^2.0.0",
    "mdast-util-gfm-strikethrough": "^2.0.0",
    "mdast-util-gfm-table": "^2.0.0",
    "mdast-util-gfm-task-list-item": "^2.0.0",
    "micromark-extension-gfm-autolink-literal": "^2.0.0",
    "micromark-extension-gfm-footnote": "^2.0.0",
    "micromark-extension-gfm-strikethrough": "^2.0.0",
    "micromark-extension-gfm-table": "^2.0.0",
    "micromark-extension-gfm-task-list-item": "^2.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@duckdb/node-api": "*",
    "@types/mdast": "^4.0.4",
    "@types/mocha": "*",
    "@types/node": "*",
    "cr": "^0.1.0",
    "node-version-use": "*",
    "ts-dev-stack": "*",
    "tsds-config": "*"
  },
  "engines": {
    "node": ">=22.20"
  },
  "allowScripts": {
    "node-semvers": true,
    "node-filename-to-dist-paths": true,
    "node-version-use": true,
    "thread-sleep-compat": true
  }

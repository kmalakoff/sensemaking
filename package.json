{
  "name": "sensemaking",
  "version": "0.9.5",
  "description": "Query and search your markdown notes with context-aware progressive disclosure: SQL over frontmatter, links, and text, plus semantic search and link-graph ranking. No server, no build step",
  "keywords": [
    "markdown",
    "frontmatter",
    "sql",
    "sqlite",
    "fts5",
    "query",
    "search",
    "semantic-search",
    "hybrid-search",
    "knowledge-base",
    "rag",
    "markdown-database",
    "document-os",
    "notes",
    "obsidian",
    "markdowndb",
    "iwe",
    "silverbullet",
    "logseq",
    "anytype",
    "zk",
    "agent",
    "agent-memory",
    "memory-consolidation",
    "llm-wiki",
    "dreaming",
    "cli"
  ],
  "homepage": "https://github.com/kmalakoff/sensemaking",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/kmalakoff/sensemaking.git"
  },
  "license": "MIT",
  "author": "Kevin Malakoff <kmalakoff@gmail.com> (https://github.com/kmalakoff)",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/cjs/index.js",
  "source": "src/index.ts",
  "types": "dist/cjs/index.d.ts",
  "bin": {
    "sense": "bin/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "schema.json"
  ],
  "scripts": {
    "build": "tsds build",
    "format": "tsds format",
    "prepublishOnly": "tsds validate",
    "test": "tsds test:node --no-timeouts",
    "test:engines": "nvu engines tsds test:node --no-timeouts",
    "version": "tsds version"
  },
  "dependencies": {
    "@huggingface/tokenizers": "^0.1.3",
    "fast-glob": "^3.3.3",
    "remove-markdown": "^0.6.4",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/mocha": "*",
    "@types/node": "*",
    "node-version-use": "*",
    "ts-dev-stack": "*",
    "tsds-config": "*"
  },
  "engines": {
    "node": ">=22.16"
  }
}
